---
import { site } from '../data/site';
---

<section id="about" class="scroll-mt-20 py-12 sm:py-16" aria-labelledby="about-heading">
  <p class="section-label">// about</p>
  <h2 id="about-heading" class="mt-2 font-mono text-2xl text-terminal-text sm:text-3xl">
    <span class="text-terminal-muted">cat</span> README.md
  </h2>

  <div class="panel mt-6 space-y-4 p-6 sm:p-8">
    {
      site.about.map((paragraph) => (
        <p class="leading-relaxed text-terminal-dim">{paragraph}</p>
      ))
    }
  </div>
</section>

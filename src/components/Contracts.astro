---
import { site } from '../data/site';
---

<section id="contracts" class="scroll-mt-20 py-12 sm:py-16" aria-labelledby="contracts-heading">
  <p class="section-label">// contracts</p>
  <h2 id="contracts-heading" class="mt-2 font-mono text-2xl text-terminal-text sm:text-3xl">
    <span class="text-terminal-muted">git log</span> --oneline contracts
  </h2>
  <p class="mt-3 max-w-2xl text-sm text-terminal-dim">
    Contract engagements outside the staff timeline — same bar for craft, separate for clarity.
  </p>

  <ol class="relative mt-8 space-y-0 border-l border-terminal-amber/30 pl-6 sm:pl-8">
    {
      site.contracts.map((item) => (
        <li class="relative pb-8 last:pb-0">
          <span
            class={`absolute -left-[1.54rem] top-1.5 h-2.5 w-2.5 rounded-full sm:-left-[2.04rem] ${
              item.featured
                ? 'bg-terminal-amber ring-4 ring-terminal-amber/20'
                : 'bg-terminal-border ring-4 ring-terminal-bg'
            }`}
            aria-hidden="true"
          />
          <article
            class={`panel p-5 ${item.featured ? 'border-terminal-amber/35 sm:p-6' : ''}`}
          >
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded border border-terminal-amber/40 px-2 py-0.5 font-mono text-[11px] uppercase tracking-wider text-terminal-amber">
                contract
              </span>
              <span class="rounded border border-terminal-border px-2 py-0.5 font-mono text-[11px] uppercase tracking-wider text-terminal-dim">
                {item.domain}
              </span>
              <span class="font-mono text-[11px] text-terminal-muted">{item.duration}</span>
            </div>
            <h3
              class={`mt-3 font-mono text-terminal-green ${item.featured ? 'text-lg sm:text-xl' : 'text-base'}`}
            >
              {item.org}
            </h3>
            <p class="mt-1 font-mono text-xs text-terminal-muted">{item.role}</p>
            <p class="mt-3 text-sm leading-relaxed text-terminal-dim sm:text-base">{item.tease}</p>
            {(item.stack.length > 0 || item.signals.length > 0) && (
              <ul class="mt-4 flex flex-wrap gap-2" aria-label="Stack and highlights">
                {item.stack.map((s) => (
                  <li class="chip border-terminal-amber/35 text-terminal-text">{s}</li>
                ))}
                {item.signals.map((s) => (
                  <li class="chip border-terminal-amber/20 text-terminal-dim">{s}</li>
                ))}
              </ul>
            )}
          </article>
        </li>
      ))
    }
  </ol>
</section>

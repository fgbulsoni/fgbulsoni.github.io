---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const printHint = 'Use your browser: Print → Save as PDF';
const iconClass = 'h-3.5 w-3.5 shrink-0';
---

<BaseLayout title={`Resume — ${site.name}`} description={`Resume for ${site.name}, ${site.title}`}>
  <div class="print:hidden">
    <Header />
  </div>

  <main class="py-10 sm:py-14 print:py-0">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3 print:hidden">
      <p class="font-mono text-xs text-terminal-muted">
        <a href="/" class="hover:text-terminal-green">← home</a>
      </p>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          id="print-resume"
          class="btn-primary"
        >
          print / save PDF
        </button>
        <a
          href={site.links.linkedin}
          class="btn-ghost"
          target="_blank"
          rel="noopener noreferrer"
        >
          linkedin
        </a>
      </div>
    </div>
    <p class="mb-6 font-mono text-xs text-terminal-muted print:hidden">{printHint}</p>

    <article class="panel resume-doc p-6 sm:p-10 print:border-0 print:bg-white print:p-0 print:text-black">
      <header class="border-b border-terminal-border pb-6 print:border-neutral-300">
        <h1 class="font-mono text-3xl text-terminal-green print:text-black">{site.name}</h1>
        <p class="mt-2 font-mono text-sm text-terminal-dim print:text-neutral-700">{site.title}</p>
        <ul
          class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-terminal-muted print:text-neutral-600"
        >
          <li class="inline-flex items-center gap-1.5">
            <svg
              class={iconClass}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{site.location}</span>
          </li>
          {
            site.email && (
              <li>
                <a
                  href={`mailto:${site.email}`}
                  class="inline-flex items-center gap-1.5 hover:text-terminal-green print:text-neutral-800"
                >
                  <svg
                    class={iconClass}
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                  {site.email}
                </a>
              </li>
            )
          }
          <li>
            <a
              href={site.links.linkedin}
              class="inline-flex items-center gap-1.5 hover:text-terminal-green print:text-neutral-800"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
              linkedin.com/in/{site.handle}
            </a>
          </li>
          <li>
            <a
              href={site.links.github}
              class="inline-flex items-center gap-1.5 hover:text-terminal-green print:text-neutral-800"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                ></path>
              </svg>
              github.com/{site.handle}
            </a>
          </li>
        </ul>
      </header>

      <section class="mt-8">
        <h2 class="font-mono text-sm uppercase tracking-wider text-terminal-cyan print:text-neutral-800">
          Summary
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-terminal-dim print:text-neutral-700">
          Hands-on Software Engineering Manager and Senior Software Engineer. Staff experience across
          healthtech marketplace platforms and integrations, finance/credit data, DevOps product tooling,
          and big-tech platforms. Contract work in live multiplayer game backends and human data for
          coding LLMs — building with the models and evaluating the software they produce.
        </p>
      </section>

      <section class="mt-8">
        <h2 class="font-mono text-sm uppercase tracking-wider text-terminal-cyan print:text-neutral-800">
          Experience
        </h2>
        <ul class="mt-4 space-y-6">
          {
            site.experience.map((item) => (
              <li>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="font-mono text-base text-terminal-green print:text-black">{item.org}</h3>
                  <span class="font-mono text-xs text-terminal-muted print:text-neutral-600">
                    {item.period}
                  </span>
                </div>
                <p class="font-mono text-xs text-terminal-muted print:text-neutral-600">
                  {item.role} · {item.domain}
                </p>
                <p class="mt-2 text-sm text-terminal-dim print:text-neutral-700">{item.tease}</p>
                {(item.stack.length > 0 || item.signals.length > 0) && (
                  <p class="mt-2 font-mono text-xs text-terminal-muted print:text-neutral-600">
                    {[...item.stack, ...item.signals].join(' · ')}
                  </p>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-8">
        <h2 class="font-mono text-sm uppercase tracking-wider text-terminal-cyan print:text-neutral-800">
          Contract experience
        </h2>
        <ul class="mt-4 space-y-6">
          {
            site.contracts.map((item) => (
              <li>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="font-mono text-base text-terminal-green print:text-black">{item.org}</h3>
                  <span class="font-mono text-xs text-terminal-muted print:text-neutral-600">
                    {item.duration}
                  </span>
                </div>
                <p class="font-mono text-xs text-terminal-muted print:text-neutral-600">
                  {item.role} · {item.domain}
                </p>
                <p class="mt-2 text-sm text-terminal-dim print:text-neutral-700">{item.tease}</p>
                {(item.stack.length > 0 || item.signals.length > 0) && (
                  <p class="mt-2 font-mono text-xs text-terminal-muted print:text-neutral-600">
                    {[...item.stack, ...item.signals].join(' · ')}
                  </p>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-8">
        <h2 class="font-mono text-sm uppercase tracking-wider text-terminal-cyan print:text-neutral-800">
          Skills
        </h2>
        <ul class="mt-4 space-y-2">
          {
            site.skills.map((group) => (
              <li class="text-sm text-terminal-dim print:text-neutral-700">
                <span class="font-mono text-terminal-green print:font-semibold print:text-black">
                  {group.group}:
                </span>{' '}
                {group.items.join(', ')}
              </li>
            ))
          }
        </ul>
      </section>
    </article>
  </main>

  <div class="print:hidden">
    <Footer />
  </div>
</BaseLayout>

<script>
  document.getElementById('print-resume')?.addEventListener('click', () => {
    window.print();
  });
</script>

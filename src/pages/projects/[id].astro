---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import { showCaseStudies } from '../../data/contentFlags';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((project) => showCaseStudies || project.data.kind !== 'case-study')
    .map((project) => ({
      params: { id: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, kind, stack, repo, demo, status, year } = project.data;

const kindLabel = kind === 'case-study' ? 'case-study' : 'playground';
const kindClass =
  kind === 'case-study'
    ? 'border-terminal-cyan/40 text-terminal-cyan'
    : 'border-terminal-amber/40 text-terminal-amber';
---

<BaseLayout title={`${title} — ${site.name}`} description={summary}>
  <Header />
  <main class="py-12 sm:py-16">
    <p class="font-mono text-xs text-terminal-muted">
      <a href="/#projects" class="hover:text-terminal-green">← projects</a>
      <span class="mx-2">/</span>
      <span>{project.id}</span>
    </p>

    <header class="mt-6 max-w-3xl">
      <div class="flex flex-wrap items-center gap-2">
        <span class={`rounded border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider ${kindClass}`}>
          {kindLabel}
        </span>
        <span class="font-mono text-[10px] uppercase tracking-wider text-terminal-muted">
          {status}
        </span>
        {year && <span class="font-mono text-[10px] text-terminal-muted">{year}</span>}
      </div>
      <h1 class="mt-4 font-mono text-3xl text-terminal-green sm:text-4xl">{title}</h1>
      <p class="mt-4 text-lg text-terminal-dim">{summary}</p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {stack.map((tech) => <li class="chip">{tech}</li>)}
      </ul>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          repo && (
            <a href={repo} class="btn-primary" target="_blank" rel="noopener noreferrer">
              view repo
            </a>
          )
        }
        {
          demo && (
            <a href={demo} class="btn-ghost" target="_blank" rel="noopener noreferrer">
              live demo
            </a>
          )
        }
      </div>
    </header>

    <article
      class:list={[
        'panel prose-portfolio mt-10 max-w-3xl p-6 sm:p-8',
        '[&_h2]:mt-8 [&_h2]:font-mono [&_h2]:text-lg [&_h2]:text-terminal-green',
        '[&_h2:first-child]:mt-0',
        '[&_p]:mt-3 [&_p]:leading-relaxed [&_p]:text-terminal-dim',
        '[&_ul]:mt-3 [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-5 [&_ul]:text-terminal-dim',
        '[&_strong]:font-medium [&_strong]:text-terminal-text',
        '[&_a]:text-terminal-cyan [&_a]:underline [&_a]:decoration-terminal-border hover:[&_a]:text-terminal-green',
      ]}
    >
      <Content />
    </article>
  </main>
  <Footer />
</BaseLayout>
